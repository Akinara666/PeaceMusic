# Logging (INFO by default; set DEBUG to see yt-dlp timing diagnostics)
# LOG_LEVEL=INFO

# Discord
DISCORD_BOT_TOKEN=

# Google Gemini API
GEMINI_API_KEY=
# PostgreSQL is the v2 persistent store. Docker Compose supplies the internal
# service URL automatically; set this for local execution.
# DATABASE_URL=postgresql://peacemusic:change-me@localhost:5432/peacemusic
# POSTGRES_DB=peacemusic
# POSTGRES_USER=peacemusic
# POSTGRES_PASSWORD=change-me
# DB_MIN_POOL_SIZE=1
# DB_MAX_POOL_SIZE=10
# HEALTH_SERVER_PORT=8080
# ENVIRONMENT=development
# LANGSMITH_TRACING=false
# GLOBAL_MAX_CONCURRENT_AI_TURNS=20
# GLOBAL_MAX_DOWNLOAD_SIZE_MB=100
# GLOBAL_MAX_QUEUE_SIZE=1000
# ALLOWED_AI_MODELS=["gemini-3.1-flash-lite"]
# Alternatively use DISCORD_BOT_TOKEN_FILE / GEMINI_API_KEY_FILE (Docker secrets).
# GEMINI_RESPONSE_MODEL=gemini-3.1-flash-lite
# Optional default personality for newly created guild settings. Guild
# administrators can override this from the Discord /settings personality modal.
# GEMINI_SYSTEM_PROMPT=You are PeaceMusic, a helpful and friendly Discord music assistant.
# GEMINI_SUMMARY_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768
# GEMINI_THINKING_BUDGET=8192
# GEMINI_TEMPERATURE=1.0
# GEMINI_TOP_P=0.95
# GEMINI_REQUEST_TIMEOUT_MS=24000
# Docker bridge: docker-compose.yml maps this name to the Linux host gateway.
# The proxy must listen on the host gateway/0.0.0.0 and be firewalled from WAN.
# GEMINI_SOCKS_PROXY=socks5://host.docker.internal:40000

# Docker host directories. Relative paths are resolved from docker-compose.yml.
APP_DATA_HOST_DIR=./data
MUSIC_FILES_HOST_DIR=./music_files

# yt-dlp cookies (optional). Use a path relative to the repository root and
# keep the file under ./data so the same .env works locally and in Docker.
# The file must be in Netscape cookies.txt format.
# YTDL_COOKIES_FILE=./data/youtube-cookies.txt
# yt-dlp external JavaScript components used to solve current YouTube
# signature challenges. Comma-separate multiple components if needed.
# YTDL_REMOTE_COMPONENTS=ejs:github
# Local-only override. Docker Compose connects to its bundled provider service.
# YTDL_POT_PROVIDER_URL=http://127.0.0.1:4416
# Persistent yt-dlp player/signature cache (speeds up repeated YouTube extracts).
# In Docker this resolves under APP_DATA_HOST_DIR on the host.
# YTDL_CACHE_DIR=data/ytdl_cache

# Music Queue
# MUSIC_QUEUE_MAX_SIZE=50
# MUSIC_ATTACHMENT_MAX_BYTES=25000000
# MEDIA_ALLOWED_DOMAINS=youtube.com,youtu.be,music.youtube.com,soundcloud.com,on.soundcloud.com

# Stream resilience. Defaults are sized for low-memory servers and usually do
# not need adjustment. The PCM buffer uses about 192 KB per second per guild.
# MUSIC_STREAM_BUFFER_SECONDS=20
# MUSIC_STREAM_START_BUFFER_SECONDS=5
# MUSIC_STREAM_START_TIMEOUT_SECONDS=15
# MUSIC_STREAM_UNDERRUN_GRACE_SECONDS=15
# MUSIC_STREAM_STALL_TIMEOUT_SECONDS=10
# MUSIC_STREAM_RESTART_COOLDOWN_SECONDS=10
# MUSIC_FFMPEG_RW_TIMEOUT_SECONDS=8

# AI rate limiting (per-user). Set MAX_REQUESTS to 0 to disable.
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
# AI_ATTACHMENT_MAX_BYTES=25000000
# AI_ATTACHMENT_MAX_COUNT=4
# AI_MAX_CONCURRENT_TURNS=4
# AI_TURN_TIMEOUT_SECONDS=120
# When CHATBOT_CHANNEL_ID is empty, require a mention in guild channels.
# AI_REQUIRE_MENTION_WHEN_UNSCOPED=true

# Memory & Context Settings (defaults shown)
# MEMORY_RECENT_MESSAGES=12
# MEMORY_SEMANTIC_RESULTS=6
# MEMORY_SEMANTIC_MIN_SCORE=0.35
# MEMORY_SUMMARY_TRIGGER=30
# MEMORY_SUMMARY_WINDOW=40
# MEMORY_SEMANTIC_HALF_LIFE_DAYS=30
# MEMORY_SEMANTIC_CANDIDATES=1000
# MEMORY_RAW_RETENTION_DAYS=90
